# Copy to .env (or export) to override development defaults.
# In production (NODE_ENV=production) JWT_SECRET, PRMS_CREW_LEADS and STORAGE are REQUIRED.

NODE_ENV=development
PORT=3000

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Session length in seconds (default 8 hours)
TOKEN_TTL_SECONDS=28800

# Exactly three Crew Leads, JSON. Passwords must be at least 12 characters.
# PRMS_CREW_LEADS=[{"username":"commander","displayName":"Cmdr. Ava Reyes","password":"..."},{"username":"navigator","displayName":"Lt. Kenji Sato","password":"..."},{"username":"medic","displayName":"Dr. Leila Haddad","password":"..."}]

# Demo mode (default: true outside production): seeds passengers, resources and a week of
# history when storage is empty, and shows the demo sign-in details on the login page.
SEED_DEMO_DATA=true

# Where data lives: memory (lost on restart) or firestore.
STORAGE=memory

# Firestore settings (STORAGE=firestore). Credentials come from Application Default
# Credentials: `gcloud auth application-default login` locally, the service account on
# Cloud Run, or none when FIRESTORE_EMULATOR_HOST points at the emulator.
# FIRESTORE_PROJECT_ID=my-project        # optional on Google Cloud
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_NAMESPACE=dev               # keeps an environment's data apart, e.g. per developer

# Number of reverse proxies in front of the app, so rate limiting sees the real client
# address. Cloud Run: 1. Default 0 (trust none).
TRUST_PROXY=0

# Sign-in attempts allowed per client per 15 minutes
LOGIN_RATE_LIMIT_MAX=20
# Changes (POST/PUT/PATCH) per signed-in account per minute
WRITE_RATE_LIMIT_MAX=60
